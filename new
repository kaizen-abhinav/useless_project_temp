// =====================================================
// Wi-Fi Access Point Configuration
// =====================================================
const char* AP_SSID     = "HelmetTracker";
const char* AP_PASSWORD = "12345678";

IPAddress local_IP(192, 168, 4, 1);
IPAddress gateway(192, 168, 4, 1);
IPAddress subnet(255, 255, 255, 0);

WebServer server(80);

// =====================================================
// Single Servo Configuration (Horizontal Tracking 0-180°)
// =====================================================
const int SERVO_PIN = 18;     // PWM pin for Servo Signal (Orange / Yellow wire)
Servo trackingServo;
int currentAngle = 90;        // Initial center position (0-180)

// =====================================================
// Relay Configuration (Top Light Control)
// =====================================================
const int RELAY_PIN = 23;     // Digital pin to Relay IN
const bool RELAY_ACTIVE_HIGH = true; // Set to true if HIGH=ON, false if Active-LOW (LOW=ON)

bool relayState = false;      // false = OFF, true = ON

void setRelay(bool state) {
    relayState = state;
    digitalWrite(RELAY_PIN, (relayState == RELAY_ACTIVE_HIGH) ? HIGH : LOW);
}

