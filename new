// =====================================================
// HTTP Route Handlers
// =====================================================
void handleRoot()
{
    server.sendHeader("Access-Control-Allow-Origin", "*");
    server.send(200, "text/html", webpage);
}

void handleSet()
{
    server.sendHeader("Access-Control-Allow-Origin", "*");

    bool hasAngle = server.hasArg("angle") || server.hasArg("pan");
    bool hasLight = server.hasArg("light");

    if (!hasAngle && !hasLight)
    {
        server.send(400, "text/plain", "Missing parameter (angle or light)");
        return;
    }

    if (hasAngle) {
        String valStr = server.hasArg("angle") ? server.arg("angle") : server.arg("pan");
        currentAngle = constrain(valStr.toInt(), 0, 180);
        trackingServo.write(currentAngle);
    }

    if (hasLight) {
        int val = server.arg("light").toInt();
        setRelay(val > 0);
    }

    // Print to Serial Monitor
    Serial.println();
    Serial.println("================================");
    Serial.println("Received command:");
    Serial.print("HORIZONTAL SERVO = ");
    Serial.print(currentAngle);
    Serial.println(" degrees");
    Serial.print("TOP LIGHT RELAY  = ");
    Serial.println(relayState ? "ON" : "OFF");
    Serial.println("================================");

    String response = "SERVO: " + String(currentAngle) + "° | LIGHT: " + (relayState ? "ON" : "OFF");
    server.send(200, "text/plain", response);
}

void handleStatus()
{
    server.sendHeader("Access-Control-Allow-Origin", "*");
    String json = "{";
    json += "\"angle\":" + String(currentAngle) + ",";
    json += "\"light\":" + String(relayState ? 1 : 0);
    json += "}";
    server.send(200, "application/json", json);
}

// =====================================================
// Setup
// =====================================================
void setup()
{
    // 1. Disable brownout detector during high motor inrush current spikes
    WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

    Serial.begin(115200);
    delay(500);

    Serial.println();
    Serial.println("==========================================");
    Serial.println("   HelmetTracker - Single Servo & Relay   ");
    Serial.println("==========================================");

    // 2. Initialize Relay on GPIO 23
    pinMode(RELAY_PIN, OUTPUT);
    setRelay(false);
    Serial.print("[OK] Relay initialized on GPIO ");
    Serial.print(RELAY_PIN);
    Serial.println(" (Default: OFF)");

    // 3. Initialize Single Servo on GPIO 18
    ESP32PWM::allocateTimer(0);
    ESP32PWM::allocateTimer(1);
    ESP32PWM::allocateTimer(2);
    ESP32PWM::allocateTimer(3);

    trackingServo.setPeriodHertz(50);
    trackingServo.attach(SERVO_PIN, 544, 2400);

    Serial.print("[OK] Servo attached to GPIO ");
    Serial.print(SERVO_PIN);
    Serial.println(trackingServo.attached() ? " [SUCCESS]" : " [FAILED]");

    // Set initial position to 90 degrees center
    trackingServo.write(currentAngle);
    Serial.println("[OK] Servo initialized to 90 degrees (Center)");

    // 4. Start Wi-Fi Access Point with balanced RF power (17dBm prevents current spikes)
    WiFi.mode(WIFI_AP);
    WiFi.softAPConfig(local_IP, gateway, subnet);
    WiFi.softAP(AP_SSID, AP_PASSWORD);
    WiFi.setTxPower(WIFI_POWER_17dBm);

    // Event listener for phone connect/disconnect
    WiFi.onEvent([](WiFiEvent_t event, WiFiEventInfo_t info) {
        if (event == ARDUINO_EVENT_WIFI_AP_STACONNECTED) {
            Serial.println("[Wi-Fi] >>> Phone connected to HelmetTracker! <<<");
        } else if (event == ARDUINO_EVENT_WIFI_AP_STADISCONNECTED) {
            Serial.println("[Wi-Fi] >>> Phone disconnected! <<<");
        }
    });

    Serial.println();
    Serial.println("[OK] Wi-Fi Access Point is Active");
    Serial.print("SSID:        ");
    Serial.println(AP_SSID);
    Serial.print("IP Address:  ");
    Serial.println(WiFi.softAPIP());

    // 5. Start HTTP Server
    server.on("/", handleRoot);
    server.on("/set", handleSet);
    server.on("/status", handleStatus);
    server.begin();

    Serial.println("[OK] Fast HTTP Server listening on port 80");
    Serial.println("------------------------------------------");
    Serial.println("Open on your phone: http://192.168.4.1/");
    Serial.println("Waiting for commands...");
    Serial.println("==========================================");
}

// =====================================================
// Main Loop
// =====================================================
void loop()
{
    server.handleClient();
}
