<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer targeting reticle circle -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26 Z"
        android:strokeColor="#00E5FF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

    <!-- Reticle tick marks -->
    <path
        android:pathData="M54,20 L54,26 M54,82 L54,88 M20,54 L26,54 M82,54 L88,54"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round" />

    <!-- Corner brackets -->
    <path
        android:pathData="M30,36 L30,30 L36,30 M78,30 L84,30 L84,36 M30,72 L30,78 L36,78 M84,72 L84,78 L78,78"
        android:strokeColor="#00B0FF"
        android:strokeWidth="1.8"
        android:strokeLineCap="square" />

    <!-- Headlight Left (P1) -->
    <path
        android:pathData="M39,58 A4.5,4.5 0 1,1 38.9,58 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M39,58 A7.5,7.5 0 1,1 38.9,58 Z"
        android:strokeColor="#FFEA00"
        android:strokeWidth="1.2" />

    <!-- Headlight Right (P2) -->
    <path
        android:pathData="M69,58 A4.5,4.5 0 1,1 68.9,58 Z"
        android:fillColor="#FFFFFF" />
    <path
        android:pathData="M69,58 A7.5,7.5 0 1,1 68.9,58 Z"
        android:strokeColor="#FFEA00"
        android:strokeWidth="1.2" />

    <!-- Headlight baseline link -->
    <path
        android:pathData="M43.5,58 L64.5,58"
        android:strokeColor="#FFEA00"
        android:strokeWidth="1.2" />

    <!-- Kinematics Aim Point (Driver windshield position - offset up & left) -->
    <!-- Headlight midpoint is (54, 58). Baseline W=30. Driver Y = 58 - 0.85*30 = 32.5. Driver X = 54 - 0.25*30 = 46.5 -->
    <path
        android:pathData="M46.5,33 A4,4 0 1,1 46.4,33 Z"
        android:fillColor="#FF1744" />
    <!-- Driver Crosshair -->
    <path
        android:pathData="M46.5,27 L46.5,39 M40.5,33 L52.5,33"
        android:strokeColor="#FF5252"
        android:strokeWidth="1.2" />

    <!-- Kinematics vector line from midpoint to driver -->
    <path
        android:pathData="M54,58 L46.5,33"
        android:strokeColor="#00E676"
        android:strokeWidth="1.5" />

</vector>
