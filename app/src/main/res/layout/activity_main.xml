<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX Fullscreen Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Transparent Graphical HUD Overlay -->
    <com.example.HudOverlayView
        android:id="@+id/hud_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Telemetry & Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#99040810">

        <TextView
            android:id="@+id/hud_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="HIGH BEAM GLARE COUNTERMEASURE // HBGCS v2.4"
            android:textColor="#00E5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Lock Status Indicator Badge -->
        <TextView
            android:id="@+id/status_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hud_status_badge"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="[PASSIVE MONITORING]"
            android:textColor="#FFB300"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- FPS & Processing Latency -->
        <TextView
            android:id="@+id/fps_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="monospace"
            android:text="FPS: 0.0 | 0ms"
            android:textColor="#80D8FF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- On-Screen Manual Teleop Pan Slider Overlay (shown in Teleop Mode) -->
    <LinearLayout
        android:id="@+id/manual_pan_container"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="85dp"
        android:background="@drawable/hud_panel_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/manual_pan_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="MANUAL SERVO PAN: 90°"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekbar_manual_pan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="180"
            android:progress="90" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_pan_left"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="#2200E5FF"
                android:fontFamily="monospace"
                android:text="0° (LEFT)"
                android:textColor="#00E5FF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_pan_center"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#2200E5FF"
                android:fontFamily="monospace"
                android:text="90° (CTR)"
                android:textColor="#00E5FF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_pan_right"
                style="@android:style/Widget.DeviceDefault.Button.Borderless"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#2200E5FF"
                android:fontFamily="monospace"
                android:text="180° (RIGHT)"
                android:textColor="#00E5FF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Telemetry HUD Panels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="bottom">

        <!-- Left Kinematics Telemetry Box -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hud_panel_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:minWidth="220dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="-- KINEMATICS TELEMETRY --"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/telemetry_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="LOCK: SEARCHING"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/telemetry_blobs_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="BLOBS: 0"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/telemetry_baseline_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="BASELINE W: ---"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/telemetry_pan_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="SERVO PAN:  90°"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/telemetry_tilt_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="GIMBAL: PAN-ONLY"
                android:textColor="#80D8FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Right Configuration & Controls Box -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hud_panel_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:minWidth="250dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="-- CONTROLS &amp; CLASSIFIER --"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/beam_type_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="BEAM: SEARCHING"
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/glare_lux_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="GLARE: 0 LUX"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/countermeasure_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="TORCH BEAM: OFF"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exposure_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="AE CLAMP: -4 EV [ON]"
                android:textColor="#00E676"
                android:textSize="12sp" />

            <!-- Row 1: AE Clamp and Sim buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_toggle_exposure"
                    style="@android:style/Widget.DeviceDefault.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#2200E5FF"
                    android:fontFamily="monospace"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="AE CLAMP"
                    android:textColor="#00E5FF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_simulate_target"
                    style="@android:style/Widget.DeviceDefault.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="#2200E676"
                    android:fontFamily="monospace"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="SIM BEAM"
                    android:textColor="#00E676"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Row 2: Manual Teleop Mode & Manual Torch Toggle Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_teleop_mode"
                    style="@android:style/Widget.DeviceDefault.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#2200E5FF"
                    android:fontFamily="monospace"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="TELEOP: OFF"
                    android:textColor="#00E5FF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_torch_toggle"
                    style="@android:style/Widget.DeviceDefault.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="#22FF1744"
                    android:fontFamily="monospace"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="TORCH: OFF"
                    android:textColor="#FF1744"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Permission Request Overlay (shown if Camera permission not yet granted) -->
    <LinearLayout
        android:id="@+id/permission_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EE080D1A"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="CAMERA PERMISSION REQUIRED"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="The Helmet CV engine requires camera access to process headlight luminance feeds and calculate driver triangulation kinematics."
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#00E5FF"
            android:fontFamily="monospace"
            android:text="GRANT CAMERA ACCESS"
            android:textColor="#080D1A"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
